# Helius API key: node RPC calls (balances, rent, account and transaction lookups) go to
# https://mainnet.helius-rpc.com and https://devnet.helius-rpc.com when it is set,
# and to the public cluster endpoints (api.mainnet-beta / api.devnet.solana.com) otherwise.
VITE_HELIUS_API_KEY=

# Custom mainnet RPC URL for the wallet connection and the mainnet node RPC (takes precedence over the Helius key).
VITE_PUBLIC_SOLANA_RPC=
