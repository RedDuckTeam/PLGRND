{
  "name": "@plgrnd/embed",
  "version": "1.0.1",
  "private": false,
  "description": "Self-hosted <plgrnd-flow> custom element: interactive PLGRND flows for documentation sites.",
  "homepage": "https://plgrnd.io",
  "keywords": [
    "plgrnd",
    "solana",
    "custom-element",
    "web-component",
    "embed",
    "documentation"
  ],
  "repository": {
    "url": "https://github.com/RedDuckTeam/PLGRND"
  },
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "node": "./dist/ssr/index.js",
      "default": "./dist/esm/plgrnd-flow.js"
    },
    "./iife": "./dist/plgrnd-flow.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/plgrnd-flow.iife.js",
    "dist/esm/",
    "dist/ssr/",
    "dist/THIRD_PARTY_LICENSES.txt",
    "types/"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dev": "vite --config vite.config.ts",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-artifacts.mjs",
    "size": "node scripts/size-report.mjs",
    "fixtures": "vite build --config vite.build.config.ts --mode fixtures && node scripts/serve-fixtures.mjs",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dismissable-layer": "1.1.11",
    "@radix-ui/react-select": "^2.2.6",
    "@rollup/plugin-inject": "5.0.5",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.2",
    "@types/node": "^24.9.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@xyflow/react": "^12.8.6",
    "aria-hidden": "^1.2.6",
    "esbuild": "^0.25.11",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "lucide-react": "^0.544.0",
    "lz-string": "^1.5.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.13",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "zustand": "^5.0.8"
  }
}
